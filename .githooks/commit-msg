#!/bin/sh
# Conventional commit guard — https://www.conventionalcommits.org
# Enabled per clone: make hooks (also runs from make install).

file="$1"
header=$(head -n 1 "$file")

case "$header" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9-]*\))?!?: .+'

if echo "$header" | grep -qE "$pattern"; then
  exit 0
fi

echo "commit message does not follow conventional commits:" >&2
echo "  $header" >&2
echo "expected: type(scope)!: subject" >&2
echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
echo "examples: 'feat(parser): attrs on headings' | 'fix: pdf retry loop' | 'docs!: new syntax'" >&2
exit 1
